# --- APIs sources ---
# Token Travelpayouts (https://www.travelpayouts.com/ -> Data API access)
TRAVELPAYOUTS_TOKEN=

# Token Duffel (optionnel — sans lui, le niveau 2 "confirmation live" est désactivé proprement)
DUFFEL_TOKEN=

# --- Alertes email ---
# Recommandé sur Railway : Resend utilise HTTPS (SMTP est bloqué sur Trial/Hobby/Free).
RESEND_API_KEY=
# Sans domaine vérifié, onboarding@resend.dev n'envoie que vers l'adresse du compte Resend.
RESEND_FROM_EMAIL=Flight Alerts <onboarding@resend.dev>

# Secours local / hébergement autorisant SMTP.
# Mot de passe d'APPLICATION Google, pas le mot de passe du compte.
# Compte Google -> Sécurité -> Validation en 2 étapes -> Mots de passe d'application
GMAIL_SMTP_USER=
GMAIL_APP_PASSWORD=
ALERT_EMAIL_TO=zied.benalaya.20@gmail.com

# --- Admin ---
# Token d'accès à l'interface d'admin (?token=... ou cookie)
ADMIN_TOKEN=change-me

# --- Infra ---
DATABASE_URL=postgresql+asyncpg://flights:flights@db:5432/flights
REDIS_URL=redis://redis:6379/0

# --- Réglages optionnels ---
COLLECT_INTERVAL_MINUTES=30
HTTP_CONCURRENCY=5
